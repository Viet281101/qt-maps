{
  "version": 8,
  "name": "QtMaps Hanoi navigation basemap",
  "metadata": {
    "qtmaps:style_revision": "qtmaps-hanoi-v2",
    "qtmaps:theme": {
      "land": "#eef3f7",
      "water": "#c8e3f5",
      "green": "#dcefd8",
      "building": "#c4ccd5",
      "road_casing": "#b7c2cd",
      "road_major": "#fffaf0",
      "road_secondary": "#f9f7f1",
      "road_local": "#ffffff",
      "label": "#263746",
      "label_halo": "#ffffff"
    }
  },
  "sprite": "__QTMAPS_BASE_URL__/sprites/sprite",
  "glyphs": "__QTMAPS_BASE_URL__/glyphs/{fontstack}/{range}.pbf",
  "sources": {
    "qtmaps": {
      "type": "vector",
      "tiles": [
        "__QTMAPS_BASE_URL__/tiles/{z}/{x}/{y}.pbf"
      ],
      "minzoom": 12,
      "maxzoom": 15,
      "attribution": "© OpenStreetMap contributors, ODbL 1.0"
    }
  },
  "layers": [
    {
      "id": "land",
      "type": "background",
      "paint": {
        "background-color": "#eef3f7"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "qtmaps",
      "source-layer": "water",
      "minzoom": 12,
      "paint": {
        "fill-color": "#c8e3f5",
        "fill-outline-color": "#acd2ec",
        "fill-opacity": 1.0
      }
    },
    {
      "id": "green-areas",
      "type": "fill",
      "source": "qtmaps",
      "source-layer": "landuse",
      "minzoom": 13,
      "paint": {
        "fill-color": "#dcefd8",
        "fill-outline-color": "#bddbb8",
        "fill-opacity": 0.9
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "qtmaps",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#c4ccd5",
        "fill-outline-color": "#a5b0bd",
        "fill-opacity": 0.82
      }
    },
    {
      "id": "road-major-casing",
      "type": "line",
      "source": "qtmaps",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "motorway",
        "trunk",
        "primary"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#b7c2cd",
        "line-width": {
          "base": 1.4,
          "stops": [
            [12, 2.2],
            [15, 8.0]
          ]
        }
      }
    },
    {
      "id": "road-major-fill",
      "type": "line",
      "source": "qtmaps",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "motorway",
        "trunk",
        "primary"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#fffaf0",
        "line-width": {
          "base": 1.4,
          "stops": [
            [12, 1.2],
            [15, 6.0]
          ]
        }
      }
    },
    {
      "id": "road-secondary-casing",
      "type": "line",
      "source": "qtmaps",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "secondary",
        "tertiary"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#c5cdd5",
        "line-width": {
          "base": 1.35,
          "stops": [
            [12, 1.2],
            [15, 5.0]
          ]
        }
      }
    },
    {
      "id": "road-secondary-fill",
      "type": "line",
      "source": "qtmaps",
      "source-layer": "transportation",
      "filter": [
        "in",
        "class",
        "secondary",
        "tertiary"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#f9f7f1",
        "line-width": {
          "base": 1.35,
          "stops": [
            [12, 0.7],
            [15, 3.8]
          ]
        }
      }
    },
    {
      "id": "road-local-casing",
      "type": "line",
      "source": "qtmaps",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": [
        "in",
        "class",
        "residential",
        "unclassified",
        "living_street",
        "service"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#d1d8df",
        "line-width": {
          "base": 1.3,
          "stops": [
            [13, 0.7],
            [15, 3.0]
          ]
        }
      }
    },
    {
      "id": "road-local-fill",
      "type": "line",
      "source": "qtmaps",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": [
        "in",
        "class",
        "residential",
        "unclassified",
        "living_street",
        "service"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": {
          "base": 1.3,
          "stops": [
            [13, 0.35],
            [15, 2.0]
          ]
        }
      }
    },
    {
      "id": "road-paths",
      "type": "line",
      "source": "qtmaps",
      "source-layer": "transportation",
      "minzoom": 15,
      "filter": [
        "in",
        "class",
        "path",
        "footway",
        "cycleway",
        "pedestrian",
        "steps"
      ],
      "paint": {
        "line-color": "#d7dde2",
        "line-width": 0.8,
        "line-dasharray": [
          2,
          2
        ]
      }
    },
    {
      "id": "road-labels-prepared",
      "type": "symbol",
      "source": "qtmaps",
      "source-layer": "transportation",
      "minzoom": 14,
      "layout": {
        "visibility": "none",
        "symbol-placement": "line",
        "text-field": "{name}",
        "text-font": [
          "QtMapsSans"
        ],
        "text-size": 12,
        "text-max-angle": 35,
        "text-padding": 4
      },
      "paint": {
        "text-color": "#263746",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "hanoi-label",
      "type": "symbol",
      "source": "qtmaps",
      "source-layer": "place",
      "filter": [
        "all",
        [
          "==",
          "class",
          "city"
        ],
        [
          "==",
          "name",
          "Hà Nội"
        ]
      ],
      "layout": {
        "visibility": "none",
        "icon-image": "marker",
        "icon-size": 0.75,
        "text-field": "HÀ NỘI",
        "text-font": [
          "QtMapsSans"
        ],
        "text-size": 16,
        "text-offset": [
          0,
          1.2
        ]
      },
      "paint": {
        "text-color": "#263746",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    }
  ]
}
